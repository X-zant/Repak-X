# Ignore frontend files - handled by Vite HMR
*.css
*.js
*.jsx
*.ts
*.tsx
*.html
*.svg
*.png
*.ico

# Atomic-write temp files that some tools create before renaming over the real file
*.tmp.*

# Ignore node_modules
node_modules

# Ignore dist folder (Vite output)
dist

# Ignore other frontend assets
public
assets
